# ============================================================================
# WebDep — Main Admin Login ID & Configuration (.env.example)
# ============================================================================
# Copy this file to .env and customize your settings.
# Leave ADMIN_PASSWORD blank on first startup to generate a random bootstrap
# password automatically (logged once at startup and saved to .env).
# ============================================================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_RESET_2FA=false

HOST=0.0.0.0
PORT=4600
DATA_DIR=./data
SESSION_TTL_S=604800
SESSION_IDLE_TIMEOUT_S=1800
FORCE_SECURE_COOKIES=false
